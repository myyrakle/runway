FROM python:3.10-slim

WORKDIR /opt/program

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    HF_HOME=/opt/program/.cache/huggingface \
    MODEL_NAME=yangheng/deberta-v3-base-absa-v1.1 \
    DEFAULT_PRECISION=fp16 \
    ALLOWED_PRECISIONS=fp16

# No build toolchain: every dep (torch/transformers/sentencepiece/safetensors)
# ships a manylinux wheel, so `pip install -e .` needs no compiler. python:3.10-slim
# already carries ca-certificates for the https wheel downloads.

# torch cu128 bundles the full CUDA runtime as nvidia-* site-packages (~4GB).
# Most of those .so are DT_NEEDED by libtorch_cuda.so and load at `import torch`
# (e.g. libcusparseLt), so they cannot be removed. Only the ones torch never links
# nor dlopens on the single-GPU eager inference path are dropped here — and IN THE
# SAME RUN as the install, since deleting them in a later layer would leave them in
# the lower layer and not shrink the image. The trailing `import torch` is a build-
# time guard that fails the build if a removed lib turns out to be required.
#   triton: torch.compile (pure-python JIT, never linked)
#   nccl:   torch.distributed multi-GPU collectives (dlopen, single-GPU never hits)
# NB: cupti is NOT removable here — libtorch_cuda.so links libcupti.so.12 as
# DT_NEEDED in this 2.8.0+cu128 build, so dropping nvidia/cuda_cupti makes
# `import torch` fail at load (the guard below catches it).
RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cu128 \
    && SP="$(python -c 'import site;print(site.getsitepackages()[0])')" \
    && rm -rf "$SP"/nvidia/nccl \
              "$SP"/triton "$SP"/torch/include "$SP"/torch/test \
    && python -c "import torch; print('torch', torch.__version__, 'cuda-build', torch.version.cuda)"

COPY pyproject.toml README.md ./
COPY app ./app

RUN python -m pip install --no-cache-dir -e .

# torch cu128 bundles the CUDA runtime as nvidia-* site-packages
# (libcusparseLt.so.0 etc.). pip's layout normally resolves these via RPATH, but
# register the dirs with the loader so `import torch` is robust across bases.
RUN python -c "import glob,os,site; dirs=[p for r in (site.getsitepackages()+[site.getusersitepackages()]) for p in glob.glob(os.path.join(r,'nvidia','*','lib'))]; open('/etc/ld.so.conf.d/nvidia-cuda-libs.conf','w').write('\n'.join(dirs)+'\n')" \
    && ldconfig

ARG PRELOAD_MODEL=1
RUN if [ "$PRELOAD_MODEL" = "1" ]; then \
      python -c "import os; from transformers import AutoModelForSequenceClassification, AutoTokenizer; model_name = os.environ['MODEL_NAME']; AutoTokenizer.from_pretrained(model_name); AutoModelForSequenceClassification.from_pretrained(model_name)"; \
    fi

# Runtime is fully offline. PRELOAD_MODEL baked the model + tokenizer into the HF
# cache above, so force transformers/hub to read ONLY that cache and never reach
# huggingface.co. Without this, from_pretrained() still does a HEAD/etag request
# to the Hub on every startup — adding latency, and stalling/failing the container
# whenever the Hub is down or egress is blocked. Must stay AFTER the preload step
# (that step needs the network). Override with `-e HF_HUB_OFFLINE=0` if you built
# with PRELOAD_MODEL=0 and intend to download at runtime.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

RUN printf '#!/bin/sh\nexec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}\n' > /usr/local/bin/serve \
    && chmod +x /usr/local/bin/serve

EXPOSE 8080

CMD ["serve"]
