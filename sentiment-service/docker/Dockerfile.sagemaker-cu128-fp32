FROM python:3.10-slim

WORKDIR /opt/program

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    HF_HOME=/opt/program/.cache/huggingface \
    MODEL_NAME=yangheng/deberta-v3-base-absa-v1.1 \
    DEFAULT_PRECISION=fp32 \
    ALLOWED_PRECISIONS=fp32

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cu128

COPY pyproject.toml README.md ./
COPY app ./app

RUN python -m pip install --no-cache-dir -e .

ARG PRELOAD_MODEL=1
RUN if [ "$PRELOAD_MODEL" = "1" ]; then \
      python -c "import os; from transformers import AutoModelForSequenceClassification, AutoTokenizer; model_name = os.environ['MODEL_NAME']; AutoTokenizer.from_pretrained(model_name); AutoModelForSequenceClassification.from_pretrained(model_name)"; \
    fi

RUN printf '#!/bin/sh\nexec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}\n' > /usr/local/bin/serve \
    && chmod +x /usr/local/bin/serve

EXPOSE 8080

CMD ["serve"]
