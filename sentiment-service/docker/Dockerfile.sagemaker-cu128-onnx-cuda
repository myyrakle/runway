FROM python:3.10-slim

WORKDIR /opt/program

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    HF_HOME=/opt/program/.cache/huggingface \
    MODEL_NAME=yangheng/deberta-v3-base-absa-v1.1 \
    DEFAULT_PRECISION=fp16 \
    ALLOWED_PRECISIONS=fp16 \
    INFERENCE_BACKEND=onnx-cuda \
    ONNX_MODEL_PATH=/opt/program/artifacts/model.onnx \
    INFERENCE_BATCH_SIZE=32 \
    MAX_BATCH_TOKENS=16384

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cu128

COPY pyproject.toml README.md ./
COPY app ./app
COPY scripts ./scripts

RUN python -m pip install --no-cache-dir -e ".[onnx]"

# torch cu128 bundles the CUDA runtime as nvidia-* site-packages
# (libcusparseLt.so.0 etc.). pip's layout normally resolves these via RPATH, but
# register the dirs with the loader so `import torch` is robust across bases.
RUN python -c "import glob,os,site; dirs=[p for r in (site.getsitepackages()+[site.getusersitepackages()]) for p in glob.glob(os.path.join(r,'nvidia','*','lib'))]; open('/etc/ld.so.conf.d/nvidia-cuda-libs.conf','w').write('\n'.join(dirs)+'\n')" \
    && ldconfig

ARG EXPORT_ONNX=1
RUN if [ "$EXPORT_ONNX" = "1" ]; then \
      python scripts/export_onnx.py --model-name "$MODEL_NAME" --output "$ONNX_MODEL_PATH"; \
    fi

# Runtime is fully offline. export_onnx.py above baked the tokenizer (and model
# weights it traced from) into the HF cache, so force transformers/hub to read ONLY
# that cache and never reach huggingface.co. At runtime this backend loads the local
# .onnx + tokenizer from cache; without these flags AutoTokenizer.from_pretrained()
# still does a HEAD/etag request to the Hub on startup — adding latency, and
# stalling/failing the container whenever the Hub is down or egress is blocked. Must
# stay AFTER the export step (it needs the network). Override with
# `-e HF_HUB_OFFLINE=0` if you built with EXPORT_ONNX=0.
ENV HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1

RUN printf '#!/bin/sh\nexec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}\n' > /usr/local/bin/serve \
    && chmod +x /usr/local/bin/serve

EXPOSE 8080

CMD ["serve"]
